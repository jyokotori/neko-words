FROM rust:1-bookworm AS builder

WORKDIR /app
COPY . .
RUN cargo build --release -p neko-server

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/neko-words-server /usr/local/bin/neko-words-server

EXPOSE 8002
CMD ["neko-words-server"]
