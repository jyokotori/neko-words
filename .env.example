# Neko Words Docker Configuration
# Copy this file to .env and fill in your values

# ===================
# Database Configuration (for docker-compose-external-db.yml)
# ===================
NEKO_DB_HOST=localhost
NEKO_DB_PORT=5432
NEKO_DB_DATABASE=nekowords
NEKO_DB_USERNAME=neko
NEKO_DB_PASSWORD=your-db-password

# ===================
# LLM — any OpenAI-compatible Chat Completions endpoint
# (OpenAI, DeepSeek, OpenRouter, Azure-via-compat, Ollama, vLLM, etc.)
# ===================
NEKO_OPENAI_API_KEY=sk-your-api-key
NEKO_OPENAI_MODEL=gpt-5.5
# NEKO_OPENAI_BASE_URL=https://api.openai.com/v1
